<Window x:Class="RobotInterface.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RobotInterface"
        mc:Ignorable="d"
        Title="Nain-terface Roboteur" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <GroupBox x:Name="Emission" Header="Emission" Grid.Column="0" Grid.Row="0" Margin="10">
            <TextBox x:Name="textBoxEmission" TextWrapping="Wrap" AcceptsReturn="False" KeyUp="textBoxEmission_KeyUp"/>
        </GroupBox>
        <GroupBox x:Name="Reception" Header="Reception" Grid.Column="1" Grid.Row="0" Margin="10">
            <TextBox x:Name="textBoxReception" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True"/>
        </GroupBox>
        <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button x:Name="buttonSend" Content="Send" HorizontalAlignment="Center" Width="100" Height="30" Click="buttonSend_Click" Margin="5 2 10 2"/>
            <Button x:Name="buttonTest" Content="Test" HorizontalAlignment="Center" Width="100" Height="30" Click="buttonSend_Click" Margin="5 2 10 2"/>
            <Button x:Name="buttonClear" Content="Clear" HorizontalAlignment="Center" Width="100" Height="30" Click="buttonClear_Click" Margin="5 2 10 2"/>
        </StackPanel>
    </Grid>
</Window>
